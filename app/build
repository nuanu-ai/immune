#!/bin/sh
# Builds only the menu-bar UI, signed ad hoc, with an absolute external core path.
# Usage: app/build [--debug] <path to immune>
# --debug builds into target/app/debug/ and permits command-line and environment
# overrides for the core path and store. Release uses the configured path and default store.
# Prints the bundle path on stdout; diagnostics go to stderr. Installs and starts nothing.
set -eu

config=release
place=
if [ "${1:-}" = --debug ]; then
  config=debug
  place=/debug
  shift
fi
if [ $# -ne 1 ]; then
  echo "usage: app/build [--debug] <path to immune>" >&2
  exit 2
fi
if [ ! -f "$1" ] || [ ! -x "$1" ]; then
  echo "app/build: not an executable file: $1" >&2
  exit 2
fi
requested=$(cd "$(dirname "$1")" && pwd -P)/$(basename "$1")
immune=$(/bin/realpath -- "$requested")

here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/.." && pwd)
out="$root/target/app"
plist="$here/Info.plist"
. "$root/scripts/prerequisites.sh"
swift_prerequisites

name=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleName' "$plist")
exe=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' "$plist")

bundle="$out$place/$name.app"
real="$(cd "$root" && pwd -P)/target/app$place/$name.app"
# A migration can pass the core from the old bundle, directly or through a link.
refuse_embedded_core() {
  [ -d "$bundle" ] && [ ! -L "$bundle" ] || return 0
  physical_bundle=$(/bin/realpath -- "$bundle")
  for path in "$requested" "$immune"; do
    case "$path" in "$physical_bundle"/*)
      missing 'the core is inside the app bundle being replaced. Build a standalone core first.' ;;
    esac
  done
}
refuse_embedded_core
# Replacing the bundle under a running app breaks it; another installed copy is fine.
refuse_if_running() {
  if ps -axww -o comm= | grep -qF -e "$bundle/Contents/" -e "$real/Contents/"; then
    missing "$name is running from $bundle. Quit it from its menu-bar icon, then run app/build again."
  fi
}
refuse_if_running

swift build -c "$config" --package-path "$here" --scratch-path "$out/swift" --product "$exe" >&2
bin=$(swift build -c "$config" --package-path "$here" --scratch-path "$out/swift" --show-bin-path)

mkdir -p "$out$place"
# It may have been opened while Swift was compiling.
refuse_if_running
refuse_embedded_core
rm -rf "$bundle"
mkdir -p "$bundle/Contents/MacOS"
cp "$plist" "$bundle/Contents/Info.plist"
# A trial bundle carries an identifier of its own. macOS opens whichever bundle it has
# registered under an identifier when a notification of that identifier is clicked, and a
# trial bundle was once opened that way in place of the real app, with the real store.
if [ "$config" = debug ]; then
  id=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$plist")
  /usr/libexec/PlistBuddy -c "Set :CFBundleIdentifier $id.debug" "$bundle/Contents/Info.plist"
fi
plutil -insert ImmuneExecutablePath -string "$immune" "$bundle/Contents/Info.plist"
plutil -lint -s "$bundle/Contents/Info.plist" >&2
cp "$bin/$exe" "$bundle/Contents/MacOS/$exe"
chmod 755 "$bundle/Contents/MacOS/$exe"

# Ad hoc: enough for the Mac it was built on. The external core is left unchanged.
codesign --force --sign - --timestamp=none "$bundle" >&2
codesign --verify --deep --strict "$bundle" >&2

echo "$bundle"
