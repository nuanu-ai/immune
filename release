#!/bin/sh
# Makes Immune's installer package: the core at /usr/local/bin/immune and the menu-bar app at
# /Applications/Immune.app, both owned by root, signed with Developer ID, notarised and stapled.
# Usage: ./release              the package to give to people, made from a commit
#        ./release --unsigned   the same payload, unsigned, only to look inside
# The signing identities and the notary profile come from the environment and nowhere else:
#   IMMUNE_SIGN_APP        the name of a "Developer ID Application: ..." identity in the keychain
#   IMMUNE_SIGN_INSTALLER  the name of a "Developer ID Installer: ..." identity in the keychain
#   IMMUNE_NOTARY_PROFILE  a keychain profile made once with `xcrun notarytool store-credentials`
# docs/release.md has the one-time steps and how to check the result. Only Apple's own tools
# make, sign and notarise the package, each called by its system path or through xcrun.
# Prints the package's path on stdout; everything else goes to stderr. Installs and starts nothing.
set -eu
cd "$(dirname "$0")"
root=$(pwd -P)
. ./scripts/rust-path.sh
. ./scripts/prerequisites.sh

signed=yes
case "$#:${1-}" in
  0:) ;;
  1:--unsigned) signed= ;;
  *)
    echo "usage: ./release [--unsigned]" >&2
    exit 2
    ;;
esac

# The place the package gives the core, which the app records; and the identifiers.
core_at=/usr/local/bin/immune
core_id=ai.nuanu.immune.core
pkg_id=ai.nuanu.immune.pkg
product_id=ai.nuanu.immune

if [ -n "$signed" ]; then
  unset_names=
  for name in IMMUNE_SIGN_APP IMMUNE_SIGN_INSTALLER IMMUNE_NOTARY_PROFILE; do
    [ -n "$(printenv "$name" || true)" ] || unset_names="$unset_names $name"
  done
  [ -z "$unset_names" ] ||
    missing "not set:$unset_names. A signed release needs the two Developer ID identities and the notary profile; docs/release.md, \"The owner's one-time steps\", says how to make them. ./release --unsigned builds the same payload without them, for inspection only."
fi

rust_prerequisites
swift_prerequisites

git rev-parse --verify -q HEAD >/dev/null 2>&1 ||
  missing "this is not a git checkout with a commit; a release is made from a commit of the repository."
commit=$(git rev-parse HEAD)
changes=$(git status --porcelain)
if [ -n "$signed" ] && [ -n "$changes" ]; then
  missing "the working tree has changes that are not committed, and a release is made from a commit. Commit them or set them aside, then run ./release again; git status lists them."
fi

for tool in /usr/bin/codesign /usr/bin/pkgbuild /usr/bin/productbuild /usr/sbin/pkgutil \
  /usr/bin/ditto /usr/bin/shasum /usr/bin/xcrun /usr/bin/jq /usr/libexec/PlistBuddy; do
  [ -x "$tool" ] || missing "$tool, which macOS ships, is not on this Mac."
done
if [ -n "$signed" ]; then
  [ -x /usr/sbin/spctl ] || missing "/usr/sbin/spctl, which macOS ships, is not on this Mac."
  # The Command Line Tools are present (swift_prerequisites), so xcrun raises no dialog.
  for tool in notarytool stapler; do
    /usr/bin/xcrun --find "$tool" >/dev/null 2>&1 ||
      missing "Apple's developer tools here have no $tool; update the Command Line Tools in System Settings, General, Software Update, or install Xcode."
  done
fi

version=$(cargo metadata --no-deps --format-version 1 --locked |
  /usr/bin/jq -r '.packages[] | select(.name == "immune") | .version')
[ -n "$version" ] || missing "cargo metadata named no version for the package immune."
app_version=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' app/Info.plist)
[ "$app_version" = "$version" ] ||
  missing "Cargo.toml says version $version and app/Info.plist's CFBundleShortVersionString says $app_version; make them the same."
app_id=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' app/Info.plist)
app_name=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleName' app/Info.plist)

out=$root/target/release-pkg
work=$out/work
if [ -n "$signed" ]; then
  pkg=$out/Immune-$version.pkg
else
  pkg=$out/Immune-$version-unsigned.pkg
fi
log=$out/Immune-$version.notary.json

# Each step says its name; one that fails stops the script with that name, after its own words.
step() {
  what=$1
  shift
  echo "release: $what" >&2
  "$@" >&2 || stopped "$what" "$1 exited with $?; what it said is above"
}
stopped() {
  echo "release: stopped at \"$1\": $2." >&2
  exit 1
}

echo "release: version $version from commit $commit" >&2
[ -z "$changes" ] || echo "release: the working tree has changes that are not committed" >&2

rm -rf "$work"
rm -f "$pkg" "$log"
mkdir -p "$work/root/Applications" "$work/root/usr/local/bin"

echo "release: building the core" >&2
core=$(./build) || stopped "building the core" "./build exited with $?; what it said is above"
echo "release: building the app, which runs the core at $core_at" >&2
bundle=$(app/build --core-at "$core_at") ||
  stopped "building the app" "app/build exited with $?; what it said is above"

staged_core=$work/root$core_at
staged_app=$work/root/Applications/$app_name.app
# Without extended attributes: a payload carries only what the build made.
step "placing the core" /usr/bin/ditto --norsrc --noextattr --noacl "$core" "$staged_core"
step "placing the app" /usr/bin/ditto --norsrc --noextattr --noacl "$bundle" "$staged_app"
chmod 755 "$work/root" "$work/root/Applications" "$work/root/usr" "$work/root/usr/local" \
  "$work/root/usr/local/bin" "$staged_core"

if [ -n "$signed" ]; then
  # --sign before --options: codesign ignores options given before the identity.
  step "signing the core" /usr/bin/codesign --sign "$IMMUNE_SIGN_APP" --force --options runtime \
    --timestamp --identifier "$core_id" "$staged_core"
  step "signing the app" /usr/bin/codesign --sign "$IMMUNE_SIGN_APP" --force --options runtime \
    --timestamp --identifier "$app_id" "$staged_app"
fi
step "checking the core's signature" /usr/bin/codesign --verify --strict --verbose=2 "$staged_core"
step "checking the app's signature" /usr/bin/codesign --verify --deep --strict --verbose=2 "$staged_app"

# Owned by root (--ownership recommended); the settings of the app's bundle are in the
# component list; no folder of scripts is given, so the package runs nothing.
step "making the component package" /usr/bin/pkgbuild --root "$work/root" \
  --component-plist packaging/component.plist --identifier "$pkg_id" --version "$version" \
  --install-location / --ownership recommended "$work/immune.pkg"
if [ -n "$signed" ]; then
  step "making the signed package" /usr/bin/productbuild --distribution packaging/distribution.xml \
    --resources packaging/resources --package-path "$work" --identifier "$product_id" \
    --version "$version" --sign "$IMMUNE_SIGN_INSTALLER" --timestamp "$pkg"
else
  step "making the unsigned package" /usr/bin/productbuild --distribution packaging/distribution.xml \
    --resources packaging/resources --package-path "$work" --identifier "$product_id" \
    --version "$version" "$pkg"
fi

# Read back what was made: only the two places in the payload, and no script.
step "opening the package" /usr/sbin/pkgutil --expand "$pkg" "$work/expanded"
[ ! -e "$work/expanded/immune.pkg/Scripts" ] ||
  stopped "opening the package" "it holds scripts, and Immune's package runs none"
payload=$(/usr/sbin/pkgutil --payload-files "$pkg") ||
  stopped "listing the payload" "pkgutil exited with $?"
# pkgbuild carries a file's extended attributes as an AppleDouble entry, ._<name>, beside it.
# One it cannot drop is com.apple.provenance, which macOS gives files that some apps' processes
# write; so such an entry is read as the file it belongs to.
unexpected=$(printf '%s\n' "$payload" | sed 's#/\._\([^/]*\)$#/\1#' |
  grep -v -e '^\.$' -e '^\./Applications$' \
  -e "^\./Applications/$app_name\.app\$" -e "^\./Applications/$app_name\.app/" \
  -e '^\./usr$' -e '^\./usr/local$' -e '^\./usr/local/bin$' -e '^\./usr/local/bin/immune$' || true)
[ -z "$unexpected" ] || stopped "listing the payload" "it holds more than the core and the app: $unexpected"

if [ -z "$signed" ]; then
  echo "release: SHA-256 $(/usr/bin/shasum -a 256 "$pkg" | cut -d ' ' -f 1)" >&2
  echo "release: this package is unsigned and not notarised, and cannot be given to anyone." >&2
  printf '%s\n' "$pkg"
  exit 0
fi

step "checking the package's signature" /usr/sbin/pkgutil --check-signature "$pkg"

echo "release: notarising: sending the package to Apple and waiting; most finish within 15 minutes" >&2
submit_code=0
submitted=$(/usr/bin/xcrun notarytool submit "$pkg" --keychain-profile "$IMMUNE_NOTARY_PROFILE" \
  --wait --output-format json) || submit_code=$?
id=$(printf '%s' "$submitted" | /usr/bin/jq -r '.id // empty' 2>/dev/null || true)
status=$(printf '%s' "$submitted" | /usr/bin/jq -r '.status // empty' 2>/dev/null || true)
[ -n "$id" ] ||
  stopped "notarising" "notarytool exited with $submit_code and named no submission: $submitted"
echo "release: submission $id ended \"$status\"" >&2
# The log is read whatever the result: an accepted submission can still carry warnings.
step "saving the notary log" /usr/bin/xcrun notarytool log "$id" \
  --keychain-profile "$IMMUNE_NOTARY_PROFILE" "$log"
issues=$(/usr/bin/jq -r '(.issues // [])[] | "\(.severity // "issue"): \(.path // "") \(.message // "")"' "$log") ||
  stopped "reading the notary log" "jq could not read $log"
if [ -n "$issues" ]; then
  echo "release: the notary log names these issues:" >&2
  printf '%s\n' "$issues" >&2
else
  echo "release: the notary log names no issues" >&2
fi
[ "$status" = Accepted ] && [ "$submit_code" -eq 0 ] ||
  stopped "notarising" "Apple did not accept the package; the log is $log"

step "stapling the ticket" /usr/bin/xcrun stapler staple "$pkg"
step "checking the stapled ticket" /usr/bin/xcrun stapler validate "$pkg"
step "asking Gatekeeper about the package" /usr/sbin/spctl -a -t install -vvv "$pkg"

echo "release: SHA-256 $(/usr/bin/shasum -a 256 "$pkg" | cut -d ' ' -f 1)" >&2
echo "release: notary log $log" >&2
printf '%s\n' "$pkg"
