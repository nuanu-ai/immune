#!/bin/sh
# All checks, in order: formatting, linter, then tests.
#
# With no argument it runs every part. A part can be asked for by name, and several in one
# call: `lint` (formatting and linter), `tests` (all of cargo test) and `tests N/M` (share N
# of M of the test binaries, as scripts/test-half.sh splits them). The check on GitHub runs
# the parts side by side, so it runs what this file runs.
set -e
cd "$(dirname "$0")"
. ./scripts/rust-path.sh
. ./scripts/prerequisites.sh

lint() {
  rust_prerequisites
  cargo fmt --check
  # The workspace: the core and the contract's crate with its example.
  cargo clippy --workspace --all-targets -- -D warnings
}

[ $# -gt 0 ] || set -- lint tests
while [ $# -gt 0 ]; do
  case "$1" in
    lint) lint ;;
    tests)
      rust_prerequisites
      case "${2-}" in
        */*)
          targets=$(scripts/test-half.sh "$2")
          shift
          # One target name per word: test files are named as Rust identifiers.
          # shellcheck disable=SC2086
          cargo test $targets
          ;;
        *) cargo test ;;
      esac
      ;;
    *)
      echo "usage: $0 [lint] [tests [N/M]]; with no argument, all of them" >&2
      exit 2
      ;;
  esac
  shift
done
