#!/bin/sh
# Builds only the core. Prints its absolute path on stdout; diagnostics go to stderr.
# Installs and starts nothing.
set -eu
cd "$(dirname "$0")"
. ./scripts/rust-path.sh
. ./scripts/prerequisites.sh
rust_prerequisites

# Respect CARGO_TARGET_DIR and cargo configuration by reading cargo's own artifact path.
artifacts=$(cargo build --release --locked --message-format=json-render-diagnostics)
immunity=$(printf "%s\n" "$artifacts" | scripts/cargo-built.sh)
[ -f "$immunity" ] && [ -x "$immunity" ] || missing "cargo finished without naming the immunity executable"
immunity=$(cd "$(dirname "$immunity")" && pwd -P)/$(basename "$immunity")
printf '%s\n' "$immunity"
