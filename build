#!/bin/sh
# Builds the menu-bar app on this Mac: immune in release, then the bundle around it.
# An app built here is not quarantined, so macOS opens it with the ad hoc signature
# app/build makes; no developer account is needed.
# Usage: ./build
# Prints the bundle's path on stdout; everything else goes to stderr.
# Exits 2 when something it needs is missing or the app is running; it installs
# nothing itself and asks nothing.
set -eu
cd "$(dirname "$0")"
. ./scripts/rust-path.sh

missing() {
  echo "build: $1" >&2
  exit 2
}

# The program is built and tested only on Apple Silicon with macOS 14 or later.
only="this program is built and tested only on Apple Silicon Macs with macOS 14 or later"
[ "$(uname -s)" = Darwin ] && [ "$(uname -m)" = arm64 ] || missing "$only."
macos=$(sw_vers -productVersion)
[ "${macos%%.*}" -ge 14 ] || missing "$only; this Mac has macOS $macos."

# Asking xcode-select where the tools are never raises the install dialog that
# running /usr/bin/swift without them would.
dev=$(xcode-select -p 2>/dev/null) || dev=
[ -x "$dev/usr/bin/swift" ] || [ -x "$dev/Toolchains/XcodeDefault.xctoolchain/usr/bin/swift" ] ||
  missing "Apple's Command Line Tools with swift are missing; install them with: xcode-select --install"

rust_hint="install Rust from https://rustup.rs (the official page) or with: brew install rustup && rustup default stable"
command -v cargo >/dev/null 2>&1 || missing "cargo, Rust's build tool, is not found; $rust_hint"
version=$(cargo --version 2>/dev/null) ||
  missing "cargo is there but has no toolchain to run; set one with: rustup default stable"
# Cargo.toml uses edition 2024, which came with Rust 1.85.
minor=$(echo "$version" | sed -n 's/^cargo 1\.\([0-9]*\)\..*/\1/p')
[ "${minor:-0}" -ge 85 ] ||
  missing "Rust 1.85 or later is needed and this is $version; update with: rustup update stable"

name=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleName' app/Info.plist)
bundle="$(pwd)/target/app/$name.app"
# The same folder by its real path, for when it was reached through a link.
real="$(pwd -P)/target/app/$name.app"

# app/build deletes the bundle before writing the new one; doing that under a running
# app breaks it. Only programs started from this bundle count, not another copy.
refuse_if_running() {
  if ps -axww -o comm= | grep -qF -e "$bundle/Contents/" -e "$real/Contents/"; then
    missing "$name is running from $bundle. Quit it from its menu-bar icon, then run ./build again."
  fi
}
refuse_if_running

cargo build --release --locked >&2
# Checked again: the build can take minutes, and the app may have been opened meanwhile.
refuse_if_running
built=$(app/build target/release/immune)

echo "$built"
echo "Built. Open it with: open \"$built\"" >&2
echo "It runs only while it is open, as an icon in the menu bar; it installs nothing into the system." >&2
