{
  "about": "Forms in which a secret reaches a command line that gitleaks's patterns, written for files, do not recognise. Read by src/secrets.rs; see rules/secrets/NOTICE for where each comes from. A rule with value_follows finds what stands before a value: the value begins where the match ends, the group key marks its key, and src/secrets.rs decides where the value ends.",
  "flag_words": [
    {
      "source": "datadog",
      "words": ["*password*", "*passwd*", "*mysql_pwd*", "*access_token*", "*auth_token*", "*api_key*", "*apikey*", "*secret*", "*credentials*", "stripetoken"]
    },
    {
      "source": "immune",
      "words": ["token", "pass", "passphrase"]
    }
  ],
  "rules": [
    {
      "kind": "detect-secrets:basic-auth",
      "keywords": ["://"],
      "regex": "://[^:/?#\\[\\]@\\s]*:([^/?#\\[\\]\\s]+)@"
    },
    {
      "kind": "immune:authorization",
      "keywords": ["authorization"],
      "regex": "(?i)\\b(?P<key>authorization):[ \\t]*(?:(?:bearer|basic|token|digest)[ \\t]+)?",
      "value_follows": true
    },
    {
      "kind": "immune:mysql-password",
      "keywords": ["mysql", "mariadb"],
      "regex": "(?:^|[\\s/])(?:mysql[a-z]*|mariadb[a-z-]*)\\s+(?:[^\\s;|&]+\\s+)*?(?P<key>-p)",
      "value_follows": true
    }
  ]
}
